    "$type": "color",
    "$description": "inferred roles, aliased to the base palette",
    "canvas": {
      "$value": "{color.neutral-50}",
      "$description": "lightest neutral, matches the measured light-leaning theme"
    },
    "ink": {
      "$value": "{color.neutral-950}",
      "$description": "darkest neutral, highest contrast against canvas"
    },
    "text-muted": {
      "$value": "{color.neutral-700}",
      "$description": "most-used mid-luminance neutral"
    },
    "surface": {
      "$value": "{color.neutral-100}",
      "$description": "neutral closest to canvas luminance"
    },
    "hairline": {
      "$value": "{color.neutral-200}",
      "$description": "next neutral near canvas, hairline-border weight"
    },
    "accent": {
      "$value": "{color.cyan}",
      "$description": "most-used chromatic color"
    },
    "accent-2": {
      "$value": "{color.cyan-2}",
      "$description": "supporting chromatic color"
    },
    "accent-3": {
      "$value": "{color.cyan-3}",
